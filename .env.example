# ── Google Cloud credentials ──────────────────────────────────────────────────
# Option A (recommended on Cloud Run): leave blank and assign a service account
#   to the Cloud Run service via --service-account flag.
# Option B (local dev / other platforms): paste the full service account JSON.
GCS_CREDENTIALS_JSON=


# GCP project and Vertex AI region
GCP_PROJECT_ID=your-project-id
GCP_LOCATION=us-central1

# ── Google Cloud Storage ──────────────────────────────────────────────────────
GCS_BUCKET_NAME=your-bucket-name

# "true"  → public https:// URLs  (bucket needs allUsers objectViewer)
# "false" → signed URLs valid 1 h  (bucket can be private)
GCS_PUBLIC_BUCKET=false

# ── Results backup + auto-cleanup (optional) ───────────────────────────────────
# Leave all six blank to keep today's behavior: one bucket (above), results
# stored permanently. Set all six to ALSO write every uploaded file to
# GCS_BACKUP_BUCKET_NAME (same path, minus the leading VTON/) and delete the
# PRIMARY bucket's copy RESULTS_PRIMARY_TTL_MINUTES after upload. See the
# README's "Results backup" section for the full design and setup steps.
GCS_BACKUP_BUCKET_NAME=
RESULTS_PRIMARY_TTL_MINUTES=15
CLOUD_TASKS_PROJECT=
CLOUD_TASKS_LOCATION=
CLOUD_TASKS_CLEANUP_QUEUE=
CLOUD_TASKS_SERVICE_ACCOUNT_EMAIL=
# This service's own full URL for its /internal/cleanup-object route, e.g.
# https://backend-vertex-gcp-xxxxx-uc.a.run.app/internal/cleanup-object
CLOUD_TASKS_WORKER_URL=

# ── Server ────────────────────────────────────────────────────────────────────
# Cloud Run sets PORT automatically; uncomment for local override
# PORT=8080
WORKER_THREADS=8
